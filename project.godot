;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Just Get To The Other Side"
config/version="0.1.0"
config/tags=PackedStringArray("2d", "game_jam")
run/main_scene="uid://bsix1apl8x7k6"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/show_image=false
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://byf88ejok6w3d"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
Global="*uid://i1m5cmfxb7m1"
Screenshots="*uid://bljdk7ctqona7"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdfxr/plugin.cfg", "res://addons/godot_super-wakatime/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/screenshots/plugin.cfg")

